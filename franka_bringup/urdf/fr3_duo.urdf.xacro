<?xml version="1.0" encoding="utf-8"?>
<!--
  Bringup entry point for FR3 Duo (dual-arm).

  Composes the franka_description FR3 Duo base with per-arm ros2_control
  hardware interfaces.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3_duo">

  <!-- Base robot (geometry, links, joints — declares all description args) -->
  <xacro:include filename="$(find franka_description)/robots/fr3_duo/fr3_duo.urdf.xacro"/>
  <!-- ros2_control hardware interface macro (per-arm) -->
  <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm.ros2_control.xacro"/>
  <!-- Real/mock hardware-plugin blocks (owned by franka_hardware) -->
  <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm_hardware_plugins.xacro"/>

  <!-- ros2_control-specific arguments (not declared by description) -->
  <xacro:arg name="robot_ips" default="['172.16.0.2','172.16.0.3']"/>
  <xacro:property name="robot_ips_list" value="${$(arg robot_ips)}"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="is_async" default="false"/>
  <xacro:arg name="thread_priority" default="98"/>

  <!-- One franka_arm_ros2_control hardware component per arm (each with its own robot_ip).
       arm i reads robot_types_list[i], arm_prefixes_list[i], robot_ips_list[i]. -->
  <xacro:macro name="fr3_duo_arm_ros2_control" params="arm_index">
    <xacro:franka_arm_ros2_control
        robot_type="${robot_types_list[arm_index]}"
        include_effort_command="true"
        include_finger_joint="false"
        arm_prefix="${arm_prefixes_list[arm_index]}_"
        is_async="$(arg is_async)"
        thread_priority="$(arg thread_priority)">
      <hardware_plugin>
        <xacro:franka_selected_arm_hardware_plugin
            use_fake_hardware="$(arg use_fake_hardware)"
            robot_ip="${robot_ips_list[arm_index]}"
            arm_prefix="${arm_prefixes_list[arm_index]}_"
            fake_sensor_commands="$(arg fake_sensor_commands)"/>
      </hardware_plugin>
    </xacro:franka_arm_ros2_control>
  </xacro:macro>

  <xacro:macro name="fr3_duo_arm_loop" params="arm_index arm_count">
    <xacro:if value="${arm_index &lt; arm_count}">
      <xacro:fr3_duo_arm_ros2_control arm_index="${arm_index}"/>
      <xacro:fr3_duo_arm_loop arm_index="${arm_index + 1}" arm_count="${arm_count}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:fr3_duo_arm_loop arm_index="0" arm_count="2"/>

</robot>
