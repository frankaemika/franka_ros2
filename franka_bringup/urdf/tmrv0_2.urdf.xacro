<?xml version="1.0" encoding="utf-8"?>
<!--
  Bringup entry point for TMR mobile base robots (standalone, no arms).

  Composes the franka_description TMR base robot with the TMR ros2_control
  hardware interface.  Used by franka_bringup launch files for mobile-only
  configurations (e.g. mobile_teleop.launch.py).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tmrv0_2">

  <!-- robot_type must be declared before include (used in filename resolution) -->
  <xacro:arg name="robot_type" default="tmrv0_2"/>

  <!-- Base robot (geometry, links, joints — declares all description args) -->
  <xacro:include filename="$(find franka_description)/robots/tmrv0_2/tmrv0_2.urdf.xacro"/>
  <!-- ros2_control hardware interface macro for TMR -->
  <xacro:include filename="$(find franka_hardware)/ros2_control/tmrv0_2.ros2_control.xacro"/>

  <!-- ros2_control-specific arguments (not declared by description) -->
  <xacro:arg name="robot_ip" default=""/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="is_async" default="false"/>
  <xacro:arg name="thread_priority" default="98"/>

  <!-- Hardware plugin selector macro -->
  <xacro:include filename="$(find franka_hardware)/ros2_control/tmrv0_2_hardware_plugins.xacro"/>

  <!-- TMR mobile base ros2_control hardware interface -->
  <xacro:tmrv0_2_ros2_control
      mobile_robot_type="tmrv0_2"
      include_passive_base="false"
      is_async="$(arg is_async)"
      thread_priority="$(arg thread_priority)">
    <hardware_plugin>
      <xacro:tmrv0_2_selected_hardware_plugin
          use_fake_hardware="$(arg use_fake_hardware)"
          robot_ip="$(arg robot_ip)"
          fake_sensor_commands="$(arg fake_sensor_commands)"/>
    </hardware_plugin>
  </xacro:tmrv0_2_ros2_control>

</robot>
